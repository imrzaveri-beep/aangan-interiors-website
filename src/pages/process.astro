---
import Base from '../layouts/Base.astro';
import PageHero from '../components/PageHero.astro';
import ProcessSteps from '../components/ProcessSteps.astro';
import SectionHeading from '../components/SectionHeading.astro';
import Img from '../components/Img.astro';
import CtaBand from '../components/CtaBand.astro';
import { processSteps, promises } from '../data/content';

const schema = {
  '@context': 'https://schema.org',
  '@type': 'HowTo',
  name: 'How Aangan Interiors designs and builds your home',
  totalTime: 'P45D',
  step: processSteps.map((s, i) => ({ '@type': 'HowToStep', position: i + 1, name: `${s.title} (${s.day})`, text: s.text })),
};
---
<Base
  title="Our Process: From Free Site Visit to Handover in 45 Days"
  description="How Aangan Interiors works: free site visit, 3D concept and fixed quote, material selection, execution with weekly photo updates, and handover with warranty in about 45 days."
  image="studioDrawing"
  schema={[schema]}
>
  <PageHero
    eyebrow="Our process"
    title="Five clear steps to your new home"
    intro="No guesswork and no surprises. You always know what happens next, and when."
  />

  <section class="container-x grid gap-16 pb-20 sm:pb-28 lg:grid-cols-12" aria-label="The five steps">
    <div class="lg:col-span-7">
      <ProcessSteps detailed />
    </div>
    <div class="hidden lg:col-span-5 lg:block">
      <div class="sticky top-28 overflow-hidden rounded-md">
        <Img name="studioDrawing" ratio={1.25} max={800} sizes="40vw" class="h-auto w-full object-cover" />
      </div>
    </div>
  </section>

  <section class="bg-sand py-20 sm:py-28" aria-labelledby="promise-heading">
    <div class="container-x">
      <SectionHeading id="promise-heading" eyebrow="Our promise" title="What you can count on" />
      <ul class="mt-12 grid gap-6 sm:grid-cols-2 lg:grid-cols-5">
        {
          promises.map((p) => (
            <li class="reveal rounded-md bg-white p-6">
              <h3 class="text-2xl">{p.title}</h3>
              <p class="mt-2 text-[0.95rem] leading-relaxed text-muted">{p.text}</p>
            </li>
          ))
        }
      </ul>
      <p class="reveal mt-10 max-w-2xl text-muted">
        Payment terms: 10% booking, 50% on material order, 35% mid-way and 5% on handover.
      </p>
    </div>
  </section>

  <CtaBand />
</Base>
