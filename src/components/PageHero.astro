---
// Page title area for inner pages, with an optional photo.
import Img from './Img.astro';
import type { PhotoKey } from '../data/photos';

interface Props {
  eyebrow?: string;
  title: string;
  intro?: string;
  photo?: PhotoKey;
}
const { eyebrow, title, intro, photo } = Astro.props;
---
{
  photo ? (
    <section class="relative isolate flex min-h-[340px] items-end overflow-hidden bg-primary sm:min-h-[420px]">
      <Img name={photo} ratio={0.42} mobileRatio={1} max={1920} sizes="100vw" priority class="absolute inset-0 -z-10 h-full w-full object-cover" />
      <div class="absolute inset-0 -z-10 bg-gradient-to-t from-ink/80 via-ink/35 to-ink/10" />
      <div class="container-x on-dark py-12 sm:py-16">
        {eyebrow && <p class="eyebrow">{eyebrow}</p>}
        <h1 class="mt-3 max-w-4xl text-5xl text-white sm:text-6xl lg:text-7xl">{title}</h1>
        {intro && <p class="mt-4 max-w-2xl text-lg text-white/90">{intro}</p>}
      </div>
    </section>
  ) : (
    <section class="container-x pt-14 pb-8 sm:pt-20 sm:pb-10">
      {eyebrow && <p class="eyebrow">{eyebrow}</p>}
      <h1 class="mt-3 max-w-4xl text-5xl sm:text-6xl lg:text-7xl">{title}</h1>
      {intro && <p class="mt-5 max-w-2xl text-lg leading-relaxed text-muted">{intro}</p>}
    </section>
  )
}
