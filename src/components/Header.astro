---
import Logo from './Logo.astro';
import Icon from './Icon.astro';
import { url } from '../lib/url';
import { business, telLink, whatsappLink } from '../config';

const mainNav = [
  { label: 'Residential', href: '/services/residential-interiors/' },
  { label: 'Commercial', href: '/services/commercial-interiors/' },
  { label: 'Kitchens', href: '/services/modular-kitchens-wardrobes/' },
  { label: 'Portfolio', href: '/portfolio/' },
  { label: 'Process', href: '/process/' },
  { label: 'About', href: '/about/' },
  { label: 'Contact', href: '/contact/' },
];

const mobileNav = [
  { label: 'Home', href: '/' },
  { label: 'Services', href: '/services/' },
  { label: 'Residential Interiors', href: '/services/residential-interiors/' },
  { label: 'Commercial Interiors', href: '/services/commercial-interiors/' },
  { label: 'Modular Kitchens & Wardrobes', href: '/services/modular-kitchens-wardrobes/' },
  { label: 'Portfolio', href: '/portfolio/' },
  { label: 'Our Process', href: '/process/' },
  { label: 'About Us', href: '/about/' },
  { label: 'Testimonials', href: '/testimonials/' },
  { label: 'FAQs', href: '/faqs/' },
  { label: 'Design Tips', href: '/design-tips/' },
  { label: 'Contact', href: '/contact/' },
];

const current = Astro.url.pathname.replace(/\/?$/, '/');
const isActive = (href: string) => {
  const full = url(href);
  return href === '/' ? current === full : current.startsWith(full);
};
---
<header class="sticky top-0 z-40 border-b border-primary/10 bg-ivory/95 backdrop-blur supports-[backdrop-filter]:bg-ivory/85">
  <div class="container-x flex h-[72px] items-center justify-between gap-4">
    <a href={url('/')} class="shrink-0" title="Home">
      <Logo class="h-9 w-auto sm:h-11" />
    </a>

    <nav aria-label="Main" class="hidden xl:block">
      <ul class="flex items-center gap-7 text-[0.94rem]">
        {
          mainNav.map((item) => (
            <li>
              <a
                href={url(item.href)}
                class:list={[
                  'py-2 transition-colors hover:text-brass-dark',
                  isActive(item.href) ? 'font-semibold text-primary underline decoration-brass decoration-2 underline-offset-8' : 'text-ink',
                ]}
                aria-current={isActive(item.href) ? 'page' : undefined}
              >
                {item.label}
              </a>
            </li>
          ))
        }
      </ul>
    </nav>

    <div class="flex items-center gap-2">
      <a href={url('/contact/#book')} class="btn-primary min-h-11! px-4! sm:px-5!">Book visit</a>
      <button
        type="button"
        class="inline-flex h-11 w-11 items-center justify-center rounded-full text-primary hover:bg-primary/10 xl:hidden"
        aria-controls="mobile-menu"
        aria-expanded="false"
        data-menu-toggle
      >
        <span class="sr-only">Open menu</span>
        <span data-icon-open><Icon name="menu" class="h-6 w-6" /></span>
        <span data-icon-close class="hidden"><Icon name="close" class="h-6 w-6" /></span>
      </button>
    </div>
  </div>

  <div id="mobile-menu" class="hidden border-t border-primary/10 bg-ivory xl:hidden" data-menu>
    <nav aria-label="Mobile" class="container-x max-h-[calc(100dvh-136px)] overflow-y-auto pt-2 pb-8 md:max-h-[calc(100dvh-72px)]">
      <ul class="divide-y divide-primary/10">
        {
          mobileNav.map((item) => (
            <li>
              <a
                href={url(item.href)}
                class:list={['flex min-h-12 items-center py-3 text-lg', isActive(item.href) && item.href !== '/' ? 'font-semibold text-primary' : 'text-ink']}
                aria-current={isActive(item.href) ? 'page' : undefined}
              >
                {item.label}
              </a>
            </li>
          ))
        }
      </ul>
      <div class="mt-6 grid grid-cols-2 gap-3">
        <a href={telLink} class="btn-outline"><Icon name="phone" /> Call</a>
        <a href={whatsappLink()} class="btn-primary" target="_blank" rel="noopener"><Icon name="whatsapp" /> WhatsApp</a>
      </div>
      <p class="mt-4 text-sm text-muted">{business.hours[0].days}: {business.hours[0].time}</p>
    </nav>
  </div>
</header>

<script>
  const toggle = document.querySelector<HTMLButtonElement>('[data-menu-toggle]');
  const menu = document.querySelector<HTMLElement>('[data-menu]');
  if (toggle && menu) {
    const label = toggle.querySelector('.sr-only');
    const setOpen = (open: boolean) => {
      toggle.setAttribute('aria-expanded', String(open));
      menu.classList.toggle('hidden', !open);
      if (label) label.textContent = open ? 'Close menu' : 'Open menu';
      toggle.querySelector('[data-icon-open]')?.classList.toggle('hidden', open);
      toggle.querySelector('[data-icon-close]')?.classList.toggle('hidden', !open);
    };
    toggle.addEventListener('click', () => setOpen(toggle.getAttribute('aria-expanded') !== 'true'));
    document.addEventListener('keydown', (e) => {
      if (e.key === 'Escape' && toggle.getAttribute('aria-expanded') === 'true') {
        setOpen(false);
        toggle.focus();
      }
    });
  }
</script>
