---
interface Props {
  eyebrow?: string;
  title: string;
  text?: string;
  id?: string;
  center?: boolean;
}
const { eyebrow, title, text, id, center = false } = Astro.props;
---
<div class:list={['reveal max-w-2xl', center && 'mx-auto text-center']}>
  {eyebrow && <p class="eyebrow">{eyebrow}</p>}
  <h2 id={id} class="mt-3 text-4xl sm:text-5xl">{title}</h2>
  {text && <p class="mt-4 text-lg leading-relaxed text-muted">{text}</p>}
</div>
