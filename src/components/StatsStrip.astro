---
import { stats } from '../data/content';
---
<dl class="grid grid-cols-2 gap-x-6 gap-y-10 lg:grid-cols-4">
  {
    stats.map((s) => (
      <div class="reveal flex flex-col border-l-2 border-brass pl-5">
        <dt class="text-sm text-muted">{s.label}</dt>
        <dd class="order-first font-serif text-4xl font-semibold text-primary sm:text-5xl">{s.value}</dd>
      </div>
    ))
  }
</dl>
